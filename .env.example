# Frameiq Backend — Environment Variables
# Copy this to .env and fill in your values

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
FRONTEND_URL=http://localhost:5173

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate a strong random secret for production:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string

# ── Pipeline ──────────────────────────────────────────────────────────────────
# Absolute path to your existing EmpireOmitted-Pipeline folder
PIPELINE_ROOT=C:/Users/dyaky/OneDrive/Desktop/EmpireOmitted-Pipeline

# ── AI Services (same keys as your existing .env) ────────────────────────────
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
FAL_KEY=
