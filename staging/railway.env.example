# Paste into the staging service's Railway Variables > RAW Editor.
# Replace every CHANGE_ME value. Do not commit real values.

FRAYMIQ_ENVIRONMENT=staging
STAGING_BOOTSTRAP=true
TEST_MODE=true
AUTO_APPROVE_ACTS=false

JWT_SECRET=CHANGE_ME_USE_A_NEW_STAGING_ONLY_RANDOM_SECRET
FRONTEND_URL=CHANGE_ME_STAGING_FRONTEND_OR_OPERATOR_ORIGIN
BACKEND_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}

CONFIG_READER_PATH=/data/pipeline/config-reader.cjs
PIPELINE_CONFIG_PATH=/data/pipeline/pipeline.config.json
DB_MODULE_PATH=/app/db
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Required when TEST_MODE=false for a production-like real episode.
ANTHROPIC_API_KEY=CHANGE_ME_STAGING_KEY
OPENAI_API_KEY=CHANGE_ME_STAGING_KEY
FAL_KEY=CHANGE_ME_STAGING_KEY
ELEVENLABS_API_KEY=CHANGE_ME_STAGING_KEY
ELEVENLABS_VOICE_ID=CHANGE_ME_STAGING_VOICE_ID

# Required only if pipeline.config.json selects a Replicate fallback.
REPLICATE_API_TOKEN=CHANGE_ME_IF_USED

# Optional. Leave unset to keep YouTube upload disabled.
# YOUTUBE_CREDENTIALS_PATH=/data/secrets/youtube-credentials.json
